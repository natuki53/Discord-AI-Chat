[Unit]
Description=Backup Discord AI Chat SQLite database

[Service]
Type=oneshot
User=discord-ai
Group=discord-ai
WorkingDirectory=/opt/discord-ai-chat/current
Environment=BOT_DATABASE_PATH=/var/lib/discord-ai-chat/bot.sqlite3
Environment=BOT_BACKUP_DIRECTORY=/var/lib/discord-ai-chat/backups
ExecStart=/usr/bin/node scripts/backup.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/discord-ai-chat
UMask=0077
