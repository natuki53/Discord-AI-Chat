# Discord Developer Portalで発行した秘密値。Gitへコミットしないこと。
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Anthropic Consoleで発行したClaude APIキー。Gitへコミットしないこと。
ANTHROPIC_API_KEY=

# 省略時はconfig/bot.yaml、未配置ならconfig/bot.example.yamlを読みます。
BOT_CONFIG=config/bot.yaml

# systemdでは /var/lib/discord-ai-chat/bot.sqlite3 を指定します。
BOT_DATABASE_PATH=data/bot.sqlite3

LOG_LEVEL=info
